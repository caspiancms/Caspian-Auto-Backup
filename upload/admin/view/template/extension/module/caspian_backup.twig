{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ action_create }}" class="btn btn-primary" onclick="$('#button-create').prop('disabled', true).html('<i class=\'fa fa-spinner fa-spin\'></i> در حال ساخت...');">
                    <i class="fa fa-plus"></i> {{ button_create }}
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    
    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
        {% endif %}
        {% if success %}
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
        {% endif %}

               {# بخش تنظیمات کرون‌جاب #}
        <div class="panel panel-default">
            <div class="panel-heading">
                    {# بخش نمایش لایسنس اختصاصی دامنه #}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-key"></i> کد لایسنس اختصاصی دامنه شما</h3>
            </div>
            <div class="panel-body">
                <p>در صورت انتقال سایت به هاست یا دامنه جدید، هنگام بازیابی (Restore) از شما کد لایسنس خواسته می‌شود. این کد را در جای امنی نگه دارید:</p>
                <div class="form-group">
                    <label class="col-sm-3 control-label">دامنه فعلی:</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" value="{{ current_domain }}" readonly />
                    </div>
                </div>
                <div class="form-group" style="margin-top:15px;">
                    <label class="col-sm-3 control-label">کد لایسنس بازیابی:</label>
                    <div class="col-sm-9">
                        <textarea class="form-control" rows="2" readonly onclick="this.select();" style="font-weight:bold; text-align:center;">{{ domain_license }}</textarea>
                    </div>
                </div>
            </div>
        </div>
                <h3 class="panel-title"><i class="fa fa-clock-o"></i> اتوماسیون بک‌آپ‌گیری (Cron Job)</h3>
            </div>
            <div class="panel-body">
                <p>{{ text_cron_info }}</p>
                <div class="form-group">
                    <label class="col-sm-3 control-label">{{ entry_cron_url }}</label>
                    <div class="col-sm-9">
                        <input type="text" class="form-control" value="{{ cron_url }}" readonly onclick="this.select();" />
                        <small>این دستور را در هاست خود (بخش Cron Jobs) تنظیم کنید. (مثلاً برای اجرای روزانه در ساعت ۲ نیمه‌شب: <code>0 2 * * * php /path/to/system/caspian_cron.php</code>)</small>
                    </div>
                </div>
            </div>
        </div>

        {# بخش لیست بک‌آپ‌ها #}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-database"></i> {{ text_list }}</h3>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <td class="text-left">{{ column_filename }}</td>
                                <td class="text-left">{{ column_size }}</td>
                                <td class="text-left">{{ column_date }}</td>
                                <td class="text-center">{{ column_action }}</td>
                            </tr>
                        </thead>
                        <tbody>
                            {% if backups %}
                                {% for backup in backups %}
                                    <tr>
                                        <td class="text-left">{{ backup.filename }}</td>
                                        <td class="text-left">{{ backup.size }}</td>
                                        <td class="text-left">{{ backup.date }}</td>
                                        <td class="text-center">
                                            <a href="{{ backup.download }}" class="btn btn-info btn-sm" data-toggle="tooltip" title="{{ button_download }}">
                                                <i class="fa fa-download"></i> دانلود پکیج بازیابی
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td class="text-center" colspan="4">{{ text_no_backups }}</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div style="text-align: center; margin-top: 20px; padding: 15px; border-top: 1px solid #e5e5e5; color: #888;">
            توسعه یافته توسط <a href="https://caspiancms.ir" target="_blank" style="color: #1e91cf; font-weight: bold;">کاسپین مارکت | CaspianCMS</a>
        </div>
    </div>
</div>
{{ footer }}